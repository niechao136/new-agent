# ---------------------------------------------------------------------------
# news-agent configuration (all variables are optional; defaults are shown)
# ---------------------------------------------------------------------------

# --- server / agent card ---
NEWS_AGENT_AGENT_NAME=news-agent
NEWS_AGENT_AGENT_VERSION=0.1.0
NEWS_AGENT_AGENT_URL=http://localhost:8080
NEWS_AGENT_HOST=0.0.0.0
NEWS_AGENT_PORT=8080
NEWS_AGENT_LOG_LEVEL=INFO

# --- request defaults ---
NEWS_AGENT_DEFAULT_LANGUAGE=zh
NEWS_AGENT_DEFAULT_LIMIT=15
NEWS_AGENT_MAX_LIMIT=50
NEWS_AGENT_DEFAULT_MODE=summarize_news

# --- reliability / timeouts (seconds) ---
NEWS_AGENT_TASK_TIMEOUT_S=180
NEWS_AGENT_FETCH_TIMEOUT_S=20
NEWS_AGENT_SOURCE_CONCURRENCY=4
NEWS_AGENT_RELEVANCE_THRESHOLD=0.2
NEWS_AGENT_MAX_ARTICLES_FOR_LLM=20

# --- cache (sqlite) ---
NEWS_AGENT_CACHE_ENABLED=1
NEWS_AGENT_CACHE_PATH=.cache/news_agent.sqlite3
NEWS_AGENT_CACHE_TTL_S=900

# --- LLM (OpenAI compatible: OpenAI / vLLM / DeepSeek / Qwen ...) ---
# Leave NEWS_AGENT_LLM_ENABLED=0 to run in fully offline heuristic mode.
NEWS_AGENT_LLM_ENABLED=1
NEWS_AGENT_LLM_MODEL=gpt-4o-mini
NEWS_AGENT_LLM_BASE_URL=
NEWS_AGENT_LLM_API_KEY=
# standard OpenAI variables are honoured as fallback
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=http://localhost:8000/v1

# --- news sources ---
# Force the deterministic in-process source (offline demo / tests)
NEWS_AGENT_USE_MOCK=0
# Extra RSS feeds appended to the default ones (comma separated)
NEWS_AGENT_EXTRA_RSS_FEEDS=
NEWS_AGENT_NEWSAPI_KEY=
NEWS_AGENT_GNEWS_KEY=
